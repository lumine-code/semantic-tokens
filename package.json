{
  "name": "semantic-tokens",
  "author": "lumine-code",
  "description": "Layer semantic highlighting over the grammar's own.",
  "repository": "https://github.com/lumine-code/semantic-tokens",
  "bugs": {
    "url": "https://github.com/lumine-code/semantic-tokens/issues"
  },
  "keywords": [
    "highlighting",
    "identifiers",
    "syntax",
    "lsp"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "docs",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "semantic-tokens.provider": {
      "versions": {
        "^1.0.0": "consumeSemanticTokens"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "enabled": {
      "title": "Enabled",
      "description": "Color identifiers with the provider's semantic classification. Also settable per language in scoped settings.",
      "scopeResolution": "grammar",
      "type": "boolean",
      "default": true
    }
  }
}
